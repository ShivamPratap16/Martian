# Logo.dev publishable key (pk_...). Never put the secret sk_ key here.
VITE_LOGO_DEV_KEY=
# Supabase project URL and publishable key (both are safe in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Cloudflare Turnstile site key (public). Its secret goes in Supabase secrets.
VITE_TURNSTILE_SITE_KEY=
